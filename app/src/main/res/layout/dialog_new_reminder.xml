<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Nhắc nhở mới"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_close_button"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_secondary" />
    </RelativeLayout>

    <!-- Title Input -->
    <EditText
        android:id="@+id/et_reminder_title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Tên nhắc nhở..."
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />

    <!-- Time Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Giờ nhắc"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Time Input -->
    <EditText
        android:id="@+id/et_time"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:focusable="false"
        android:clickable="true"
        android:hint="08:00"
        android:inputType="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp"
        android:text="08:00" />

    <!-- Icon Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Biểu tượng"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Icon Grid -->
    <LinearLayout
        android:id="@+id/icon_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/icon_0" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="💧" android:textSize="18sp" />
        <TextView android:id="@+id/icon_1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="📅" android:textSize="18sp" />
        <TextView android:id="@+id/icon_2" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="💪" android:textSize="18sp" />
        <TextView android:id="@+id/icon_3" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="📖" android:textSize="18sp" />
        <TextView android:id="@+id/icon_4" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="📧" android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/icon_5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="🏃" android:textSize="18sp" />
        <TextView android:id="@+id/icon_6" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="💊" android:textSize="18sp" />
        <TextView android:id="@+id/icon_7" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="🍎" android:textSize="18sp" />
        <TextView android:id="@+id/icon_8" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="☕" android:textSize="18sp" />
        <TextView android:id="@+id/icon_9" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_chip_category_default" android:gravity="center" android:text="🛌" android:textSize="18sp" />
    </LinearLayout>

    <!-- Color Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Màu sắc"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Color Picker -->
    <LinearLayout
        android:id="@+id/color_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View android:id="@+id/color_0" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/circle_icon_green" />
        <View android:id="@+id/color_1" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/circle_icon_blue" />
        <View android:id="@+id/color_2" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/circle_icon_purple" />
        <View android:id="@+id/color_3" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/circle_icon_yellow" />
        <View android:id="@+id/color_4" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/circle_icon_red" />
        <View android:id="@+id/color_5" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/circle_icon_red" />
    </LinearLayout>

    <!-- Repeat Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Lặp lại"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Repeat Chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_repeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:singleSelection="false"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_mon"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 2"
            android:textColor="@drawable/chip_repeat_text_selector"
            app:chipBackgroundColor="@drawable/chip_repeat_bg_selector"
            app:chipStrokeColor="@drawable/chip_repeat_stroke_selector"
            app:chipStrokeWidth="1dp"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_tue"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 3"
            android:textColor="@drawable/chip_repeat_text_selector"
            app:chipBackgroundColor="@drawable/chip_repeat_bg_selector"
            app:chipStrokeColor="@drawable/chip_repeat_stroke_selector"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_wed"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 4"
            android:textColor="@drawable/chip_repeat_text_selector"
            app:chipBackgroundColor="@drawable/chip_repeat_bg_selector"
            app:chipStrokeColor="@drawable/chip_repeat_stroke_selector"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_thu"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 5"
            android:textColor="@drawable/chip_repeat_text_selector"
            app:chipBackgroundColor="@drawable/chip_repeat_bg_selector"
            app:chipStrokeColor="@drawable/chip_repeat_stroke_selector"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_fri"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 6"
            android:textColor="@drawable/chip_repeat_text_selector"
            app:chipBackgroundColor="@drawable/chip_repeat_bg_selector"
            app:chipStrokeColor="@drawable/chip_repeat_stroke_selector"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sat"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ 7"
            android:textColor="@drawable/chip_repeat_text_selector"
            app:chipBackgroundColor="@drawable/chip_repeat_bg_selector"
            app:chipStrokeColor="@drawable/chip_repeat_stroke_selector"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sun"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chủ nhật"
            android:textColor="@drawable/chip_repeat_text_selector"
            app:chipBackgroundColor="@drawable/chip_repeat_bg_selector"
            app:chipStrokeColor="@drawable/chip_repeat_stroke_selector"
            app:chipStrokeWidth="1dp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Add Button -->
    <TextView
        android:id="@+id/btn_add_reminder"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="Tạo nhắc nhở"
        android:textColor="@color/bg_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
